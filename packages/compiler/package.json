{
  "name": "@turbineh/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Intent compiler: prompt to BuildSpec with an open model",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@turbineh/shared": "workspace:*",
    "openai": "7.23.0",
    "zod": "4.6.5",
    "@turbineh/decider": "workspace:*"
  }
}
