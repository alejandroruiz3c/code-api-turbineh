{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.turbineh.com/schemas/turbineh.component/v0.1.json",
  "title": "TurbineH component manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "category",
    "source",
    "capability",
    "contract",
    "compat",
    "effects",
    "integration",
    "quality",
    "security",
    "license",
    "evidence",
    "relations"
  ],
  "properties": {
    "schema": {
      "const": "turbineh.component/v0.1"
    },
    "id": {
      "description": "category.capability.implementation",
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+){2,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": ["discovered", "evaluated", "approved", "deprecated"]
    },
    "category": {
      "enum": [
        "security",
        "auth",
        "authz",
        "data",
        "ui",
        "files",
        "email",
        "payments",
        "jobs",
        "observability",
        "ops",
        "deploy",
        "ai",
        "content",
        "seo",
        "commerce",
        "storage",
        "domain",
        "site",
        "growth",
        "social",
        "media",
        "messaging"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purl", "repo"],
      "properties": {
        "purl": {
          "type": "string",
          "pattern": "^pkg:[a-z]+/.+@.+$"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha(256|384|512)-.+$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does", "does_not", "use_cases"],
      "properties": {
        "does": {
          "type": "string",
          "minLength": 10
        },
        "does_not": {
          "type": "string",
          "minLength": 5
        },
        "use_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "errors", "limits"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "runtime": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "peer": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "fs", "db", "external_services"],
      "properties": {
        "network": {
          "type": "boolean"
        },
        "fs": {
          "type": "boolean"
        },
        "db": {
          "type": "boolean"
        },
        "external_services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "install"],
      "properties": {
        "strategy": {
          "enum": ["dependency", "vendored-with-provenance", "adapter", "fork"]
        },
        "install": {
          "type": "string"
        },
        "config": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "migrations": {
          "type": "boolean"
        },
        "types": {
          "type": "string",
          "pattern": "^@types/[a-z0-9._-]+@\\d+\\.\\d+\\.\\d+$",
          "description": "Exact DefinitelyTyped package for libraries without bundled TypeScript types (installed as a devDependency)."
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests"],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "passed"],
          "properties": {
            "command": {
              "type": "string"
            },
            "passed": {
              "type": "boolean"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "findings", "scope"],
      "properties": {
        "scanned_at": {
          "type": "string",
          "format": "date"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity"],
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "enum": ["critical", "high", "medium", "low", "info"]
              },
              "mitigation": {
                "type": "string"
              }
            }
          }
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "detected"],
      "properties": {
        "declared": {
          "type": "string"
        },
        "detected": {
          "type": "string"
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "origin"],
        "properties": {
          "claim": {
            "type": "string"
          },
          "origin": {
            "enum": ["maintainer", "model-inferred", "tested", "unknown"]
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "provides", "conflicts", "tested_with"],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tested_with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "params": {
      "description": "Parameters a domain component reads from the request (ADR-0041): the app file the assembler writes and the JSON Schema it must satisfy (the shipped default in files/ satisfies it too).",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "schema"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^src/[a-z0-9/_-]+\\.json$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+\\.json$"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Entity names the component implements: the CRUD generator never duplicates them."
        }
      }
    },
    "modules": {
      "description": "Optional modules (ADR-0064, tree-shaking): parts of files/ that ship only when the request justifies their capability (or a deterministic condition holds). Shared files mark the module's lines between `turbineh:module <id>` and `turbineh:end-module <id>`.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "about", "capability", "files"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "about": {
            "type": "string",
            "minLength": 10
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
          },
          "when": {
            "enum": ["public-toolkit"]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "nav": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
