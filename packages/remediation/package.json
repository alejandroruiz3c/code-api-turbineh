{
  "name": "@turbineh/remediation",
  "version": "0.0.0",
  "private": true,
  "description": "Security remediation: deterministic dependency fixes and specialist-model code fixes, followed by full re-verification",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@turbineh/decider": "workspace:*",
    "@turbineh/shared": "workspace:*",
    "@turbineh/verifier": "workspace:*",
    "openai": "7.23.0",
    "zod": "4.6.5"
  }
}
