# Anchored to the repository root so app routes such as src/app/v1/builds are never excluded.
node_modules
**/node_modules
**/.next
**/dist
/builds
/artifacts
/bench/results/runs
/ingest/.cache
.env*
**/.env*
*.rtf
/.claude
# The private orchestration engine (ADR-0053) is git-ignored but MUST be uploaded with production web deploys.
!/private
!/private/orchestration/**
/private/orchestration/.git
/private/orchestration/node_modules
/private/orchestration/bench
