[Unit]
Description=CODE-API-TURBINEH build worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=turbineh
WorkingDirectory=/opt/code-api-turbineh
EnvironmentFile=/etc/turbineh/worker.env
ExecStart=/usr/bin/pnpm --filter @turbineh/worker run service
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
