{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "FindWorker", "Effect": "Allow", "Action": "ec2:DescribeInstances", "Resource": "*" },
    {
      "Sid": "StartWorkerOnly",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:eu-west-3:*:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Name": "turbineh-worker-prod-aws" } }
    }
  ]
}
