{
  "name": "code-api-turbineh",
  "private": true,
  "description": "Prompt-to-production software generator that selects verified components instead of generating everything.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:validate": "pnpm --filter @turbineh/catalog run validate",
    "smoke:decider": "pnpm --filter @turbineh/decider run smoke",
    "smoke:compiler": "pnpm --filter @turbineh/compiler run smoke",
    "smoke:backup-coder": "pnpm --filter @turbineh/backup-coder run smoke",
    "bench": "tsx bench/run.ts",
    "open-decider": "uv run --python 3.12 --with quyet==1.0.2 python services/open-decider/server.py",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @turbineh/db run migrate",
    "ingest": "pnpm --filter @turbineh/ingest run ingest",
    "build:local": "pnpm --filter @turbineh/worker run build:local",
    "catalog:curate": "pnpm --filter @turbineh/curation exec tsx src/cli.ts",
    "catalog:watch": "pnpm --filter @turbineh/curation exec tsx src/watch.ts",
    "catalog:sync": "pnpm --filter @turbineh/ingest run sync"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "type": "module"
}
