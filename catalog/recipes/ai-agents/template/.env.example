# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: transactional email via Resend (otherwise emails are logged locally)
RESEND_API_KEY=
EMAIL_FROM="App <onboarding@resend.dev>"
# Secret for POST /api/jobs/run, which processes queued AI process items (Vercel Cron calls it with CRON_SECRET).
# At least 32 random characters.
JOBS_RUNNER_SECRET=
