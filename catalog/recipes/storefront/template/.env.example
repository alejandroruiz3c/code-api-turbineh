# Copy to .env.local for local development. Never commit real values.
# PostgreSQL. This value is the zero-setup local database (pnpm db:local, started by db:migrate, dev and test:e2e)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: transactional email via Resend (otherwise emails are logged locally)
RESEND_API_KEY=
EMAIL_FROM="App <onboarding@resend.dev>"
# Comma-separated admin emails allowed to manage products, shipping, taxes and orders (optional: empty = nobody, deny by default; set it to sign in as staff)
ADMIN_EMAILS=you@example.com
# Stripe secret key (sk_test_… or sk_live_…). Without it the shop works as a catalog without online payment
STRIPE_SECRET_KEY=
# Signing secret of your Stripe webhook endpoint (whsec_…), pointing to /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Currency of every price (ISO code in lowercase, e.g. eur, usd, gbp)
SHOP_CURRENCY=eur
# Extra currencies buyers can choose, e.g. usd,gbp (each needs prices you set in the admin panel; no exchange rates)
SHOP_CURRENCIES=
# true = product prices already include tax (usual in the EU); false = tax is added at checkout (usual in the US)
SHOP_PRICES_INCLUDE_TAX=true
# manual = your tax rates by country (admin panel); stripe = Stripe Tax computes tax at checkout (activate Stripe Tax and add your tax registrations in your Stripe dashboard first)
SHOP_TAX_MODE=manual
