# Copy to .env.local for local development. Never commit real values.
# PostgreSQL. This value is the zero-setup local database (pnpm db:local, started by db:migrate, dev and test:e2e)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Transactional email via Resend. Required in production (the app refuses to start without it, unless
# EMAIL_DELIVERY=disabled). In development emails go to .turbineh/email-outbox.jsonl; links are never logged.
RESEND_API_KEY=
EMAIL_FROM="App <onboarding@resend.dev>"
# Optional: proxies in front of the app whose X-Forwarded-For is trusted for per-IP limits (0-5; Vercel: 1 by default)
TRUSTED_PROXY_HOPS=
# Comma-separated admin emails allowed to read the waitlist (optional: empty = nobody, deny by default; set it to sign in as staff)
ADMIN_EMAILS=you@example.com
