{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "domain.workflow.turbineh params (src/workflow/params.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflows"],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "description": "A workspace role key (see domain.membership-access.turbineh), \"creator\" (whoever created the record) or \"*\" (any member)."
    }
  },
  "properties": {
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "plural",
          "initial",
          "dueDate",
          "createRoles",
          "states",
          "transitions"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key",
            "description": "Record kind, e.g. request, loan, piece, task."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "plural": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "stateNoun": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "The request's word for the state, e.g. stage, status, phase (criteria aliases, ADR-0046)."
          },
          "initial": {
            "$ref": "#/$defs/key",
            "description": "State of a new record."
          },
          "dueDate": {
            "type": "boolean",
            "description": "Records carry a due date (overdue = past it and not final)."
          },
          "createRoles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/role"
            }
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "limitHours", "final"],
              "properties": {
                "key": {
                  "$ref": "#/$defs/key"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "limitHours": {
                  "type": ["number", "null"],
                  "exclusiveMinimum": 0,
                  "maximum": 8760,
                  "description": "Flag a record stuck after this many hours in the state; null = never."
                },
                "final": {
                  "type": "boolean",
                  "description": "No transition leaves a final state."
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "label", "roles"],
              "properties": {
                "from": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/$defs/key"
                  }
                },
                "to": {
                  "$ref": "#/$defs/key"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "description": "Button text."
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "$ref": "#/$defs/role"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
