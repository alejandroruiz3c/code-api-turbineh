{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "domain.membership-access.turbineh params (src/membership/params.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "defaultRole", "inviteRoles", "invitationDays", "scope"],
  "properties": {
    "roles": {
      "description": "Workspace roles from the request and what each may do. An \"owner\" role that manages members is required (whoever creates the workspace is its owner).",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "can"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "can": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "create",
                "update",
                "delete",
                "manage_members",
                "view_audit",
                "see_all_scopes"
              ]
            }
          }
        }
      },
      "contains": {
        "type": "object",
        "properties": {
          "key": { "const": "owner" },
          "can": { "contains": { "const": "manage_members" } }
        },
        "required": ["key", "can"]
      }
    },
    "defaultRole": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,23}$",
      "description": "Least privileged role, given when a stored role is unknown."
    },
    "inviteRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
      "description": "Roles that can be granted by invitation (owners can also invite owners)."
    },
    "invitationDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "Days an invitation link stays valid."
    },
    "scope": {
      "description": "Per-record access scope (company, project, shop…); roles without see_all_scopes see only their scopes. null = no scopes.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "plural"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
            "label": { "type": "string", "minLength": 1, "maxLength": 40 },
            "plural": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      ]
    }
  }
}
