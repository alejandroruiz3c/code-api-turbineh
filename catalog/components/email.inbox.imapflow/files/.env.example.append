# Mailbox (email.inbox.imapflow): one IMAP mailbox read read-only (EXAMINE + BODY.PEEK; nothing is marked, moved or
# deleted). Set MAIL_IMAP_HOST and MAIL_IMAP_USER plus exactly one credential: an app password (MAIL_IMAP_PASSWORD) or
# an OAuth 2.0 access token (MAIL_IMAP_ACCESS_TOKEN, XOAUTH2: Gmail, Microsoft 365). TLS on port 993 by default;
# MAIL_IMAP_SECURE=false is refused unless the server runs on this machine. Unset = the mailbox is not read.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_IMAP_SECURE=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_ACCESS_TOKEN=
MAIL_IMAP_MAILBOX=
MAIL_IMAP_MAX_PER_SYNC=
