# AI Safety Pack (always on with the AI orchestrator). Limits per user and per workspace; empty = defaults.
# Longest text accepted by the assistant (characters, default 20000)
AI_MAX_INPUT_CHARS=
# AI requests per user per minute (default 20)
AI_REQUESTS_PER_MINUTE_PER_USER=
# Daily token allowance per user / per workspace (defaults 200000 / 2000000)
AI_DAILY_TOKENS_PER_USER=
AI_DAILY_TOKENS_PER_WORKSPACE=
# true = replace emails, phone numbers, IBANs and card numbers before they reach a model (default false)
AI_REDACT_PII=
