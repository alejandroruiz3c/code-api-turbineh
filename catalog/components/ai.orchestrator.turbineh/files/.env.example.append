# AI (TurbineH component #001): choose ONE of two equal options (see DEPLOY.md).
# Option 1 · TurbineH gateway: set TURBINEH_AI_TOKEN; the gateway orchestrates each request, the app keeps and runs its
# tools, no provider keys in the app.
TURBINEH_AI_URL=https://software.turbineh.com/v1/ai
# Gateway token of this app (tbh_ai_…): "Get AI access token" on the build page, or set for you by "Deploy for me"
TURBINEH_AI_TOKEN=
# Optional: embeddings model (only models the gateway allows)
AI_EMBEDDING_MODEL=
# Option 2 · your own provider, used only when TURBINEH_AI_TOKEN is empty: any OpenAI-compatible endpoint (e.g. a self-hosted
# open model), base URL including its version path (https://host/v1), its key and the model it serves. A plain tool loop
# without TurbineH orchestration; safety, limits, usage and audit still apply.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Public assistant (/assistant, only when a toolkit is public): max characters, requests per minute per IP, turns
AI_PUBLIC_MAX_INPUT_CHARS=
AI_PUBLIC_REQUESTS_PER_MINUTE=
AI_PUBLIC_TURNS_PER_CONVERSATION=
