# AI (TurbineH component #001): every AI call goes through the TurbineH AI gateway — JEV-orchestrated open models,
# with TurbineH's own model and decider access. No provider or decider keys are needed in this app.
TURBINEH_AI_URL=https://software.turbineh.com/v1/ai
# Gateway token of this app (tbh_ai_…): "Get AI access token" on the build page, or set for you by "Deploy for me"
TURBINEH_AI_TOKEN=
# Optional overrides (only models the gateway allows): planner model, routes (name=model, cheapest first), embeddings
AI_STRUCTURER_MODEL=
AI_ROUTES=
AI_EMBEDDING_MODEL=
