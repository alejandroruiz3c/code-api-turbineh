# AI orchestrator (TurbineH component #001): every AI call goes JEV-orchestrated to open models.
# Decider: JEV by TypeSafe (https://typesafe.ai). Optional TYPESAFE_BASE_URL = an open SystemOne-compatible decider.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
# Any OpenAI-compatible endpoint serving open models (default: Scaleway Generative APIs, EU) and its key
AI_BASE_URL=https://api.scaleway.ai/v1
AI_API_KEY=
# Optional overrides: planner model, routes the decider chooses from (name=model, cheapest first), embedding model
AI_STRUCTURER_MODEL=
AI_ROUTES=
AI_EMBEDDING_MODEL=
