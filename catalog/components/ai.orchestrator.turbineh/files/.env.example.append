# AI (TurbineH component #001): every AI call goes through the TurbineH AI gateway, which orchestrates it; the app
# keeps its tools and runs them. No provider keys are needed in this app.
TURBINEH_AI_URL=https://software.turbineh.com/v1/ai
# Gateway token of this app (tbh_ai_…): "Get AI access token" on the build page, or set for you by "Deploy for me"
TURBINEH_AI_TOKEN=
# Optional: embeddings model (only models the gateway allows)
AI_EMBEDDING_MODEL=
# Optional, only when TURBINEH_AI_TOKEN is empty: any OpenAI-compatible endpoint (e.g. a self-hosted open model), base
# URL including its version path (https://host/v1), its key and the model it serves. A plain tool loop without
# TurbineH orchestration; safety, limits, usage and audit still apply.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Public assistant (/assistant, only when a toolkit is public): max characters, requests per minute per IP, turns
AI_PUBLIC_MAX_INPUT_CHARS=
AI_PUBLIC_REQUESTS_PER_MINUTE=
AI_PUBLIC_TURNS_PER_CONVERSATION=
