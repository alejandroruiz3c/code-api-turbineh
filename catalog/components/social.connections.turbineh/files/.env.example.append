# Social accounts (social.connections.turbineh). Tokens are stored encrypted with AES-256-GCM under this key:
# 32 random bytes, base64 (`openssl rand -base64 32`). Without it, accounts cannot be connected. While rotating, put
# the old key in SOCIAL_TOKEN_KEY_PREVIOUS until every account has been connected again.
SOCIAL_TOKEN_KEY=
SOCIAL_TOKEN_KEY_PREVIOUS=
# Each provider's app credentials (leave empty to hide that provider). Redirect URI to register with each provider:
# <APP_URL>/api/social/oauth/<linkedin|meta|x>/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration id (replaces the scope list when set).
META_LOGIN_CONFIG_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Pinned API versions (override only after checking the provider's changelog).
LINKEDIN_VERSION=202609
META_GRAPH_VERSION=v26.0
