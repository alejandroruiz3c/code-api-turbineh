# Private uploads (storage.private-uploads.turbineh). Without S3_BUCKET files are stored on local disk in UPLOADS_DIR
# (outside public/; fine for one server, not for serverless hosts whose disk is not persistent).
UPLOADS_DIR=.data/uploads
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2…), private; requests are signed with SigV4.
# S3_BASE_URL is the endpoint (path-style), e.g. https://<account>.r2.cloudflarestorage.com; default: AWS in S3_REGION.
STORAGE_DRIVER=
S3_BASE_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
