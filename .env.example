# Copy to .env.local (never committed) and fill in. See docs/adr/0003-backup-coder.md and docs/adr/0004-decider.md.

# Decider (JEV by TypeSafe AI + open alternative)
TYPESAFE_API_KEY=
DECIDER_PRIMARY=jev            # jev | open
DECIDER_FALLBACK=open          # jev | open | none
OPEN_DECIDER_BASE_URL=http://127.0.0.1:8765

# Compiler model (open, OpenAI-compatible endpoint; local Ollama by default)
COMPILER_BASE_URL=http://127.0.0.1:11434/v1
COMPILER_MODEL=gemma4:12b
COMPILER_API_KEY=
MODEL_REASONING_EFFORT=        # "none" on Scaleway to disable thinking

# Backup Coder (always connected; open-weights models only, see ADR-0003)
# Format: <provider-id>:<model-id>. Provider = any OpenAI-compatible endpoint (EU-hosted).
BACKUP_CODER_PRIMARY=
BACKUP_CODER_PRIMARY_BASE_URL=
BACKUP_CODER_PRIMARY_API_KEY=
BACKUP_CODER_SECONDARY=
BACKUP_CODER_SECONDARY_BASE_URL=
BACKUP_CODER_SECONDARY_API_KEY=
# Open model that writes the user report (same endpoint as the compiler). Default: glm-5.2
REPORT_WRITER_MODEL=
# Sandbox resources for verification (docker --memory / --cpus)
SANDBOX_MEMORY=
SANDBOX_CPUS=

# Delivery / infra (later WPs)
GITHUB_TOKEN=

# Platform email via Resend (ADR-0056): priority-list confirmations and the owner's demand alerts. Optional: without
# the key these emails are skipped (one warning). Defaults: EMAIL_FROM "TurbineH <support@turbineh.com>",
# DEMAND_ALERT_EMAIL alex.ruiz@turbineh.com.
RESEND_API_KEY=
EMAIL_FROM=
DEMAND_ALERT_EMAIL=
