# Copy to .env.local (never committed) and fill in. See docs/adr/0003-backup-coder.md and docs/adr/0004-decider.md.

# Decider (JEV by TypeSafe AI + open alternative)
TYPESAFE_API_KEY=
DECIDER_PRIMARY=jev            # jev | open
DECIDER_FALLBACK=open          # jev | open | none
OPEN_DECIDER_BASE_URL=http://127.0.0.1:8765

# Compiler model (open, OpenAI-compatible endpoint; local Ollama by default)
COMPILER_BASE_URL=http://127.0.0.1:11434/v1
COMPILER_MODEL=gemma4:12b
COMPILER_API_KEY=

# Backup Coder (always connected)
BACKUP_CODER_PRIMARY=anthropic:claude-opus-5-5
BACKUP_CODER_SECONDARY=openai:gpt-6-sol
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Delivery / infra (later WPs)
GITHUB_TOKEN=
